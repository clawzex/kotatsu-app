<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

	<!-- iOS-style typography -->
	<style name="TextAppearance.Kotatsu.iOS.LargeTitle" parent="TextAppearance.Material3.HeadlineLarge">
		<item name="android:textSize">@dimen/ios_large_title_size</item>
		<item name="android:letterSpacing">0.011</item>
		<item name="android:fontFamily">sans-serif-medium</item>
		<item name="fontFamily">sans-serif-medium</item>
	</style>

	<style name="TextAppearance.Kotatsu.iOS.Title1" parent="TextAppearance.Material3.HeadlineMedium">
		<item name="android:textSize">@dimen/ios_title1_size</item>
		<item name="android:letterSpacing">0.012</item>
		<item name="android:fontFamily">sans-serif-medium</item>
	</style>

	<style name="TextAppearance.Kotatsu.iOS.Title2" parent="TextAppearance.Material3.HeadlineSmall">
		<item name="android:textSize">@dimen/ios_title2_size</item>
		<item name="android:letterSpacing">0.016</item>
		<item name="android:fontFamily">sans-serif-medium</item>
	</style>

	<style name="TextAppearance.Kotatsu.iOS.Title3" parent="TextAppearance.Material3.TitleLarge">
		<item name="android:textSize">@dimen/ios_title3_size</item>
		<item name="android:letterSpacing">0.019</item>
		<item name="android:fontFamily">sans-serif-medium</item>
	</style>

	<style name="TextAppearance.Kotatsu.iOS.Body" parent="TextAppearance.Material3.BodyLarge">
		<item name="android:textSize">@dimen/ios_body_size</item>
		<item name="android:letterSpacing">-0.024</item>
	</style>

	<style name="TextAppearance.Kotatsu.iOS.Callout" parent="TextAppearance.Material3.BodyMedium">
		<item name="android:textSize">@dimen/ios_callout_size</item>
	</style>

	<style name="TextAppearance.Kotatsu.iOS.Subhead" parent="TextAppearance.Material3.BodyMedium">
		<item name="android:textSize">@dimen/ios_subhead_size</item>
		<item name="android:textColor">@color/ios_label_secondary</item>
	</style>

	<style name="TextAppearance.Kotatsu.iOS.Footnote" parent="TextAppearance.Material3.BodySmall">
		<item name="android:textSize">@dimen/ios_footnote_size</item>
		<item name="android:textColor">@color/ios_label_secondary</item>
	</style>

	<style name="TextAppearance.Kotatsu.iOS.SectionHeader" parent="TextAppearance.Kotatsu.iOS.Title3">
		<item name="android:textAllCaps">false</item>
		<item name="android:paddingStart">@dimen/ios_spacing_lg</item>
		<item name="android:paddingEnd">@dimen/ios_spacing_lg</item>
		<item name="android:paddingTop">@dimen/ios_spacing_section</item>
		<item name="android:paddingBottom">@dimen/ios_spacing_sm</item>
	</style>

	<style name="TextAppearance.Kotatsu.iOS.Caption1" parent="TextAppearance.Material3.LabelSmall">
		<item name="android:textSize">@dimen/ios_caption_size</item>
		<item name="android:fontFamily">sans-serif-medium</item>
		<item name="android:letterSpacing">0.02</item>
	</style>

</resources>
